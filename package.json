{
  "name": "tutor-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node server.js",
    "server:dev": "nodemon server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm start\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.0.5",
    "@angular/cdk": "^21.0.3",
    "@angular/common": "^21.0.5",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^21.0.5",
    "@angular/material": "^21.0.3",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.5",
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^10.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "ngx-toastr": "^19.1.0",
    "nodemailer": "^6.9.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^8.2.2",
    "jsdom": "^27.1.0",
    "nodemon": "^3.0.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
